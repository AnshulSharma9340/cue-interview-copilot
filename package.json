{
  "name": "cue-copilot",
  "productName": "Cue",
  "version": "2.0.0",
  "description": "Real-time AI call and interview assistant: live transcription, AI answers, screenshots, notes and mock interviews.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "local.cue.copilot",
    "productName": "Cue",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "src/**/*", "renderer/**/*", "stt/**/*", "assets/**/*", "node_modules/**/*", "package.json"],
    "asarUnpack": ["stt/**"],
    "win": { "target": ["nsis"], "icon": "assets/icon.png" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cue",
      "artifactName": "Cue-Setup-${version}.exe"
    }
  },
  "dependencies": {
    "mammoth": "1.8.0",
    "marked": "12.0.2",
    "pdf-parse": "1.1.1"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  }
}
